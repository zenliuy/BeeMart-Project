@{
    var mode = ViewData["Mode"] as string;
    var role = User.IsInRole("Admin") ? "Admin" : "Cashier";
}
<div class="topbar">
    <span class="brand">BeeMart</span>
    <div class="topbar-right">
        @if (mode == "history")
        {
            <span class="session-info">Role: <b class="role-text">@role</b> | Login: @User.Identity!.Name</span>
        }
        else
        {
            <span class="session-info"><span id="clock"></span> | Kasir: @User.Identity!.Name</span>
        }
        <form method="post" asp-controller="Account" asp-action="Logout">
            <button type="submit" class="btn-logout">Logout</button>
        </form>
    </div>
</div>